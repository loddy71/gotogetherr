# Optional: live pricing. Without these the app runs fully offline on the
# built-in estimator.

# URL of the running pricing proxy (server/pricing-proxy.mjs)
EXPO_PUBLIC_PRICE_PROXY_URL=http://localhost:8787

# Web origin used in share links generated on iOS/Android builds
EXPO_PUBLIC_WEB_URL=https://your-deployed-web-app.example

# For the proxy process itself (get keys at https://developers.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=production
