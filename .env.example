# Optional: live pricing. Without it the app runs fully offline on the
# calibrated built-in estimator.

# URL of a pricing proxy that implements GET /flight and GET /stay
# (contract in src/lib/pricing/proxy-provider.ts; upstream options in
# docs/DATA_SOURCES.md)
# EXPO_PUBLIC_PRICE_PROXY_URL=http://localhost:8787

# Web app URL used in share links generated on iOS/Android builds
EXPO_PUBLIC_WEB_URL=https://loddy71.github.io/gotogetherr

# Subpath the web export is served from (set by the GitHub Pages workflow;
# leave unset for local dev)
# EXPO_PUBLIC_BASE_URL=/gotogetherr
