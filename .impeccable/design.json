  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Signal-orange slab for the one primary path on a screen (Find cities, Save trip).",
      "html": "<button class=\"ds-btn-primary\">Find cities</button>",
      "css": ".ds-btn-primary{min-height:54px;padding:0 24px;background:#FF5A1F;border:1px solid #FF5A1F;border-radius:10px;color:#111418;font:600 15px/21px Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:transform .16s cubic-bezier(.2,.8,.2,1),opacity .16s}.ds-btn-primary:hover{background:#FF6A33}.ds-btn-primary:active{transform:scale(.97);opacity:.9}.ds-btn-primary:focus-visible{outline:2px solid #FF5A1F;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
