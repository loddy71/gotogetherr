      "refersTo": "segmented-track",
      "description": "Ranking mode switch; orange thumb glides to the selected mode.",
      "html": "<div class=\"ds-seg\" role=\"tablist\"><button>Cheapest</button><button class=\"on\">Balanced</button><button>Fairest</button></div>",
      "css": ".ds-seg{display:flex;padding:3px;background:#ECEEF1;border-radius:10px;width:340px}.ds-seg button{flex:1;min-height:38px;border:0;background:transparent;border-radius:7px;color:#59616C;font:600 13px/18px Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background .28s cubic-bezier(.2,.8,.2,1),color .28s}.ds-seg button.on{background:#FF5A1F;color:#111418;box-shadow:0 2px 6px rgba(17,20,24,.1)}.ds-seg button:focus-visible{outline:2px solid #FF5A1F;outline-offset:2px}"
